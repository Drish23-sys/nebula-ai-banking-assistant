# Copy to .env and fill in as needed.

# Ollama (local LLM host) — default assumes Ollama running locally
OLLAMA_HOST=http://localhost:11434
PRIMARY_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
STRETCH_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Groq Cloud — required for handover-summary generation (§4.3)
GROQ_API_KEY=
GROQ_HANDOVER_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=qwen-2.5-72b

# Embeddings / Vector DB
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=banking_policy_kb

# Sandbox DB
SANDBOX_DB_PATH=data/sandbox.db
KNOWLEDGE_BASE_DIR=data/knowledge_base

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
